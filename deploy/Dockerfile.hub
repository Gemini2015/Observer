# Observer hub（Node.js + SQLite + Web 控制台）
# 构建上下文：仓库根目录；用法：
#   docker build -f deploy/Dockerfile.hub -t observer-hub .

# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY hub/package.json ./hub/package.json
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile --filter hub... --filter web...

COPY hub ./hub
COPY web ./web
RUN pnpm --filter hub build && pnpm --filter web build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/hub/node_modules ./hub/node_modules
COPY --from=build /app/hub/dist ./hub/dist
COPY --from=build /app/hub/public ./hub/public
COPY --from=build /app/hub/migrations ./hub/migrations
COPY --from=build /app/hub/package.json ./hub/package.json
COPY --from=build /app/web/package.json ./web/package.json

USER node
ENV OBSERVER_DATA_DIR=/data
EXPOSE 8787
CMD ["node", "hub/dist/main.js"]
